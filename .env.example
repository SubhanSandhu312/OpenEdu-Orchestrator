# Copy to .env (gitignored) and fill in real values for staging/prod.
# Every variable here has a local-dev fallback baked into config.py /
# pieas_source_mysql.py, so this file is only needed to override those.

# Real Odoo/OpenEduCat instance (OdooXmlRpcClient, --target real)
OPENEDU_ODOO_URL=http://localhost:8070
OPENEDU_ODOO_DB=openeducat_test
OPENEDU_ODOO_USERNAME=admin
OPENEDU_ODOO_PASSWORD=admin

# Real MySQL-backed PIEAS source (pieas_source_mysql.py, --source pieas-mysql)
OPENEDU_PIEAS_MYSQL_HOST=127.0.0.1
OPENEDU_PIEAS_MYSQL_PORT=3307
OPENEDU_PIEAS_MYSQL_USER=pieas_app
OPENEDU_PIEAS_MYSQL_PASSWORD=pieas_app_pw
OPENEDU_PIEAS_MYSQL_DATABASE=pieas_real

# Gemini API key for the mapping-authoring tool (mapping_authoring.py)
GEMINI_API_KEY=

# Structured logging level (logging_config.py) -- DEBUG/INFO/WARNING/ERROR
OPENEDU_LOG_LEVEL=INFO
